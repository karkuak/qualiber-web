---
/**
 * Qualiber logo mark — the "Q that resolves a signal into a verdict".
 * Ring = currentColor (adapts to theme), signal = neutral grey,
 * verdict node + tail = the site accent (--accent).
 * Size is controlled by the consuming CSS (e.g. .brand .mark { width } ).
 */
interface Props { class?: string }
const { class: cls = 'mark' } = Astro.props;
---
<svg class={cls} viewBox="0 0 48 48" fill="none" aria-hidden="true">
  <circle cx="23" cy="23" r="15" stroke="currentColor" stroke-width="3"></circle>
  <path d="M10.5 23 L14.2 17.6 L17.8 27.4 L21.4 19.4 L24.8 24.6 L28 23" stroke="#8B96A0" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
  <path d="M28.5 23 L39 39" stroke-width="3" stroke-linecap="round" style="stroke:var(--accent)"></path>
  <circle cx="28.4" cy="23" r="3.9" style="fill:var(--accent)"></circle>
</svg>
