---
import Logo from '../Logo.astro';
---
<section class="hero hero-company" id="top">
  <div class="wrap hero-grid">
    <div>
      <h1><em>Qualiber</em> builds software and tools that help teams <em>assess</em> the quality of applications and AI systems, understand the risks, and make <em>informed decisions</em>.</h1>
      <div class="cta-row">
        <a class="btn btn-primary" href="#contact">Request a demo →</a>
        <a class="btn btn-ghost" href="#products">Our products</a>
      </div>
    </div>
    <div class="hero-mark" aria-hidden="true">
      <Logo variant="mark" class="hero-mark-svg" />
    </div>
  </div>
</section>
